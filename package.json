{
  "name": "pulse-notification-system",
  "version": "1.0.0",
  "description": "Durable real-time notification API with PostgreSQL outbox, Redis fan-out, and Socket.IO delivery.",
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "outbox": "node src/cli/outbox.js",
    "test": "node src/db/migrate.js test && vitest run",
    "migrate:test": "node src/db/migrate.js test",
    "test:multi-instance": "node scripts/multi-instance-smoke.js",
    "test:load": "node scripts/load-test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devanshjaincampaign-tech/pulse-notification-engine.git"
  },
  "keywords": [
    "notifications",
    "real-time",
    "outbox",
    "socket.io",
    "postgresql"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20.13.0"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/devanshjaincampaign-tech/pulse-notification-engine/issues"
  },
  "homepage": "https://github.com/devanshjaincampaign-tech/pulse-notification-engine#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "socket.io-client": "^4.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
