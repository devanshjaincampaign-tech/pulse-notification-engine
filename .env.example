# Development placeholders only. Replace credentials and signing secrets before
# using this configuration outside a private local environment.

# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=pulse_notifications
DB_HOST=postgres
DB_PORT=5432
DB_POOL_MAX=25
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional, when PostgreSQL uses a non-system CA:
# DB_SSL_CA_FILE=/run/secrets/postgres-ca.pem

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false
# Set credentials through a secret manager when Redis ACL authentication is enabled.
REDIS_USERNAME=
REDIS_PASSWORD=

JWT_SECRET=changeme

# --- SMTP notification delivery (required when email notifications are enabled) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pulse Notifications <no-reply@example.com>

# Must be set to your real frontend's domain in production — never leave unset or wildcard in prod
CORS_ORIGIN=

# --- Durable event outbox ---
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY_MS=500
OUTBOX_RETRY_MAX_DELAY_MS=30000
OUTBOX_LEASE_MS=60000

# --- WebSocket abuse limits ---
WS_MAX_CONNECTIONS_PER_IP=10
WS_MAX_HANDSHAKES_PER_MINUTE=60
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_PAYLOAD_BYTES=65536
# Set true only when the application is behind a trusted proxy that overwrites X-Forwarded-For.
WS_TRUST_PROXY=false

# Required to expose /metrics in production; send as Authorization: Bearer <token>.
METRICS_TOKEN=